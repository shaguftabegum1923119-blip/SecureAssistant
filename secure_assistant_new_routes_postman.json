{
  "info": {
    "name": "Secure Assistant - new routes (help, support, dvr, owner)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://secureassistant.onrender.com"
    },
    {
      "key": "idToken",
      "value": "PASTE_FIREBASE_ID_TOKEN"
    },
    {
      "key": "ticketId",
      "value": "TICKET_ID"
    },
    {
      "key": "approvalId",
      "value": "APPROVAL_ID"
    },
    {
      "key": "bridgeId",
      "value": "BRIDGE_ID"
    }
  ],
  "item": [
    {
      "name": "Help",
      "item": [
        {
          "name": "Help pages (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/help/pages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "help",
                "pages"
              ]
            }
          }
        },
        {
          "name": "Help page by id or key (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/help/page/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "help",
                "page",
                "1"
              ]
            }
          }
        },
        {
          "name": "Help categories (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/help/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "help",
                "categories"
              ]
            }
          }
        },
        {
          "name": "Help category by id (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/help/category/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "help",
                "category",
                "1"
              ]
            }
          }
        },
        {
          "name": "Home data (login)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/home/data?categoryId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "home",
                "data"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Support",
      "item": [
        {
          "name": "Support chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"My payment was cut but the plan did not start\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/ticket",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "ticket"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Payment problem\",\n  \"message\": \"Money was deducted on 22 Oct, Rs 99\",\n  \"category\": \"payment\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "My tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "tickets"
              ]
            }
          }
        },
        {
          "name": "Request approval",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/request-approval",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "request-approval"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"refund\",\n  \"reason\": \"Double payment\",\n  \"details\": \"Paid twice on 22 Oct\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "My approval requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/support/approvals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "support",
                "approvals"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "DVR",
      "item": [
        {
          "name": "Create DVR bridge (paid plan)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dvr/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dvr",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Shop DVR\",\n  \"cameraIds\": [\n    \"CAMERA_ID_1\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "My DVR bridges",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dvr/list",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dvr",
                "list"
              ]
            }
          }
        },
        {
          "name": "Delete DVR bridge",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dvr/{{bridgeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dvr",
                "{{bridgeId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Owner (only OWNER_UID account)",
      "item": [
        {
          "name": "Owner: tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/owner/tickets?status=open",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "owner",
                "tickets"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open"
                }
              ]
            }
          }
        },
        {
          "name": "Owner: reply to ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/owner/tickets/{{ticketId}}/reply",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "owner",
                "tickets",
                "{{ticketId}}",
                "reply"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reply\": \"Your payment is verified.\",\n  \"close\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Owner: approval requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/owner/approvals?status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "owner",
                "approvals"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "Owner: decide request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/owner/approvals/{{approvalId}}/decide",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "owner",
                "approvals",
                "{{approvalId}}",
                "decide"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"note\": \"Refund will reach in 2-3 days\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}